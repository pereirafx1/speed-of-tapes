<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the real ATAS assembly name so SpeedOfTape resolves the reference -->
    <AssemblyName>ATAS.Indicators</AssemblyName>
    <RootNamespace>ATAS.Indicators</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Description>
      Compile-time stubs for the ATAS SDK. DO NOT deploy to ATAS.
      Used only to allow local compilation of SpeedOfTape.cs without a real ATAS installation.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF color types — part of standard .NET Framework 4.8 on Windows -->
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
  </ItemGroup>

</Project>
